---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
    title?: string;
}

const { title = "Alken Flor | Portfolio" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content="Alken Flor's personal portfolio." />
        <title>Astro</title>
    </head>

    <body class="bg-white text-center text-slate-900 dark:bg-slate-900 dark:text-white">

        <h1 class="mt-12 text-3xl font-bold text-red-700 underline">
            Philip Alexander P. Juayong
        </h1>

        <div class="my-5 flex justify-center gap-3">
            <button id="replayBtn" class="btn-primary rounded border px-4 py-2">
                Replay Intro
            </button>

            <button id="darkModeToggle" class="btn-primary rounded border px-4 py-2">
                Toggle Dark Mode
            </button>
        </div>

        <Header />

        <main>
            <slot />
        </main>

        <Footer />

        <script>
            import { gsap } from "gsap";

            const tl = gsap.timeline({
                defaults: {
                    duration: 0.8,
                    ease: "power2.out",
                },
            });

            tl.from("h1", { y: -40, opacity: 0 })
              .from("nav a", {
                  y: -20,
                  opacity: 0,
                  stagger: 0.15,
              }, "-=0.4");

            document.querySelector("#replayBtn")?.addEventListener("click", () => {
                tl.restart();
            });

            document.querySelector("#darkModeToggle")?.addEventListener("click", () => {
                document.documentElement.classList.toggle("dark");
            });
        </script>

    </body>
</html>