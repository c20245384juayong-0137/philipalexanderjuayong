---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
interface Props {
  title?: string;
}

const { title = "Philip Alexander P. Juayong | Portfolio" } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Philip Alexander P. Juayong's personal portfolio." />
    <title>{title}</title>
    <script is:inline>
      if (localStorage.getItem("theme") === "light") {
        document.documentElement.classList.remove("dark");
      }
    </script>
  </head>

  <body class="bg-white text-slate-900 dark:bg-slate-900 dark:text-white">
    <Header />

    <main>
      <slot />
    </main>

    <Footer />

    <script>
      import "../scripts/animation.js";
    </script>
  </body>
</html>
